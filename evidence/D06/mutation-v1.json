ctLiteral","replacement":"{}","statusReason":"expected false to equal true","status":"Killed","static":false,"testsCompleted":1,"duration":2,"killedBy":["6"],"coveredBy":["6"],"location":{"end":{"column":8,"line":41},"start":{"column":35,"line":39}}},{"id":"29","mutatorName":"StringLiteral","replacement":"\"\"","statusReason":"expected false to equal true","status":"Killed","static":false,"testsCompleted":1,"duration":3,"killedBy":["6"],"coveredBy":["6"],"location":{"end":{"column":45,"line":40},"start":{"column":18,"line":40}}},{"id":"30","mutatorName":"ConditionalExpression","replacement":"true","statusReason":"expected false to equal true","status":"Killed","static":false,"testsCompleted":1,"duration":2,"killedBy":["4"],"coveredBy":["4","5","7"],"location":{"end":{"column":35,"line":44},"start":{"column":9,"line":44}}},{"id":"31","mutatorName":"ConditionalExpression","replacement":"false","statusReason":"expected false to equal true","status":"Killed","static":false,"testsCompleted":2,"duration":7,"killedBy":["5"],"coveredBy":["4","5","7"],"location":{"end":{"column":35,"line":44},"start":{"column":9,"line":44}}},{"id":"32","mutatorName":"EqualityOperator","replacement":"routeUserId === authUserId","statusReason":"expected false to equal true","status":"Killed","static":false,"testsCompleted":1,"duration":1,"killedBy":["4"],"coveredBy":["4","5","7"],"location":{"end":{"column":35,"line":44},"start":{"column":9,"line":44}}},{"id":"33","mutatorName":"BlockStatement","replacement":"{}","statusReason":"expected false to equal true","status":"Killed","static":false,"testsCompleted":1,"duration":1,"killedBy":["5"],"coveredBy":["5"],"location":{"end":{"column":6,"line":48},"start":{"column":37,"line":44}}},{"id":"34","mutatorName":"ObjectLiteral","replacement":"{}","statusReason":"expected false to equal true","status":"Killed","static":false,"testsCompleted":1,"duration":3,"killedBy":["5"],"coveredBy":["5"],"location":{"end":{"column":8,"line":47},"start":{"column":35,"line":45}}},{"id":"35","mutatorName":"StringLiteral","replacement":"\"\"","statusReason":"expected false to equal true","status":"Killed","static":false,"testsCompleted":1,"duration":2,"killedBy":["5"],"coveredBy":["5"],"location":{"end":{"column":58,"line":46},"start":{"column":18,"line":46}}},{"id":"36","mutatorName":"CallExpression","replacement":";","statusReason":"expected false to equal true","status":"Killed","static":false,"testsCompleted":1,"duration":3,"killedBy":["4"],"coveredBy":["4","7"],"location":{"end":{"column":12,"line":50},"start":{"column":5,"line":50}}},{"id":"37","mutatorName":"ObjectLiteral","replacement":"{}","statusReason":"requireAuth is not a function","status":"Killed","static":true,"testsCompleted":1,"duration":3,"killedBy":["0"],"coveredBy":[],"location":{"end":{"column":2,"line":57},"start":{"column":18,"line":54}}}],"source":"const jwt = require('jsonwebtoken');\r\n\r\nconst requireAuth = (req, res, next) => {\r\n  const authHeader = req.headers.authorization;\r\n\r\n  if (!authHeader) {\r\n    return res.status(401).json({\r\n      message: 'Authorization token required'\r\n    });\r\n  }\r\n\r\n  const token = authHeader.split(' ')[1];\r\n\r\n  if (!token) {\r\n    return res.status(401).json({\r\n      message: 'Authorization token required'\r\n    });\r\n  }\r\n\r\n  try {\r\n    const decodedUser = jwt.verify(token, process.env.JWT_SECRET);\r\n\r\n    req.user = decodedUser;\r\n\r\n    next();\r\n  } catch (err) {\r\n    res.status(401).json({\r\n      message: 'Invalid or expired token'\r\n    });\r\n  }\r\n};\r\n\r\nconst requireSameUser = (paramName = 'userId') => {\r\n  return (req, res, next) => {\r\n    const routeUserId = Number(req.params[paramName]);\r\n    const authUserId = Number(req.user?.id);\r\n\r\n    if (!Number.isInteger(routeUserId)) {\r\n      return res.status(400).json({\r\n        message: 'Valid user id is required'\r\n      });\r\n    }\r\n\r\n    if (routeUserId !== authUserId) {\r\n      return res.status(403).json({\r\n        message: 'You can only access your own resources'\r\n      });\r\n    }\r\n\r\n    next();\r\n  };\r\n};\r\n\r\nmodule.exports = {\r\n  requireAuth: requireAuth,\r\n  requireSameUser: requireSameUser\r\n};"}},"schemaVersion":"1.0","thresholds":{"high":80,"low":60,"break":null},"testFiles":{"test/baseline-ai/authMiddleware.ai.test.js":{"tests":[{"id":"0","name":"AI Baseline: Authentication Middleware requireAuth should reject a request with no authorization header"},{"id":"1","name":"AI Baseline: Authentication Middleware requireAuth should reject an authorization header with no token"},{"id":"2","name":"AI Baseline: Authentication Middleware requireAuth should attach the decoded user and call next for a valid token"},{"id":"3","name":"AI Baseline: Authentication Middleware requireAuth should reject an invalid or expired token"},{"id":"4","name":"AI Baseline: Authentication Middleware requireSameUser should allow a user to access their own resources"},{"id":"5","name":"AI Baseline: Authentication Middleware requireSameUser should reject access to another user resources"},{"id":"6","name":"AI Baseline: Authentication Middleware requireSameUser should reject a non-integer user ID"},{"id":"7","name":"AI Baseline: Authentication Middleware requireSameUser should support a custom route parameter name"}],"source":"\r\nconst { expect } = require('chai');\r\nconst sinon = require('sinon');\r\nconst jwt = require('jsonwebtoken');\r\n\r\nconst {\r\n  requireAuth,\r\n  requireSameUser\r\n} = require('../../middleware/authMiddleware');\r\n\r\ndescribe('AI Baseline: Authentication Middleware', function () {\r\n  let req;\r\n  let res;\r\n  let next;\r\n\r\n  beforeEach(function () {\r\n    req = {\r\n      headers: {},\r\n      params: {},\r\n      user: undefined\r\n    };\r\n\r\n    res = {\r\n      status: sinon.stub().returnsThis(),\r\n      json: sinon.stub().returnsThis()\r\n    };\r\n\r\n    next = sinon.stub();\r\n  });\r\n\r\n  afterEach(function () {\r\n    sinon.restore();\r\n  });\r\n\r\n  describe('requireAuth', function () {\r\n    it('should reject a request with no authorization header', function () {\r\n      requireAuth(req, res, next);\r\n\r\n      expect(res.status.calledOnceWithExactly(401)).to.equal(true);\r\n      expect(res.json.calledOnceWithExactly({\r\n        message: 'Authorization token required'\r\n      })).to.equal(true);\r\n      expect(next.called).to.equal(false);\r\n    });\r\n\r\n    it('should reject an authorization header with no token', function () {\r\n      req.headers.authorization = 'Bearer';\r\n\r\n      requireAuth(req, res, next);\r\n\r\n      expect(res.status.calledOnceWithExactly(401)).to.equal(true);\r\n      expect(res.json.calledOnceWithExactly({\r\n        message: 'Authorization token required'\r\n      })).to.equal(true);\r\n      expect(next.called).to.equal(false);\r\n    });\r\n\r\n    it('should attach the decoded user and call next for a valid token', function () {\r\n      const decodedUser = { id: 7, email: 'test@example.com' };\r\n\r\n      req.headers.authorization = 'Bearer valid-token';\r\n\r\n      const verifyStub = sinon.stub(jwt, 'verify')\r\n        .returns(decodedUser);\r\n\r\n      requireAuth(req, res, next);\r\n\r\n      expect(verifyStub.calledOnceWithExactly(\r\n        'valid-token',\r\n        process.env.JWT_SECRET\r\n      )).to.equal(true);\r\n      expect(req.user).to.equal(decodedUser);\r\n      expect(next.calledOnce).to.equal(true);\r\n      expect(res.status.called).to.equal(false);\r\n    });\r\n\r\n    it('should reject an invalid or expired token', function () {\r\n      req.headers.authorization = 'Bearer invalid-token';\r\n\r\n      sinon.stub(jwt, 'verify').throws(new Error('Invalid token'));\r\n\r\n      requireAuth(req, res, next);\r\n\r\n      expect(res.status.calledOnceWithExactly(401)).to.equal(true);\r\n      expect(res.json.calledOnceWithExactly({\r\n        message: 'Invalid or expired token'\r\n      })).to.equal(true);\r\n      expect(next.called).to.equal(false);\r\n    });\r\n  });\r\n\r\n  describe('requireSameUser', function () {\r\n    it('should allow a user to access their own resources', function () {\r\n      req.params.userId = '7';\r\n      req.user = { id: 7 };\r\n\r\n      requireSameUser()(req, res, next);\r\n\r\n      expect(next.calledOnce).to.equal(true);\r\n      expect(res.status.called).to.equal(false);\r\n    });\r\n\r\n    it('should reject access to another user resources', function () {\r\n      req.params.userId = '8';\r\n      req.user = { id: 7 };\r\n\r\n      requireSameUser()(req, res, next);\r\n\r\n      expect(res.status.calledOnceWithExactly(403)).to.equal(true);\r\n      expect(res.json.calledOnceWithExactly({\r\n        message: 'You can only access your own resources'\r\n      })).to.equal(true);\r\n      expect(next.called).to.equal(false);\r\n    });\r\n\r\n    it('should reject a non-integer user ID', function () {\r\n      req.params.userId = 'abc';\r\n      req.user = { id: 7 };\r\n\r\n      requireSameUser()(req, res, next);\r\n\r\n      expect(res.status.calledOnceWithExactly(400)).to.equal(true);\r\n      expect(res.json.calledOnceWithExactly({\r\n        message: 'Valid user id is required'\r\n      })).to.equal(true);\r\n      expect(next.called).to.equal(false);\r\n    });\r\n\r\n    it('should support a custom route parameter name', function () {\r\n      req.params.accountId = '7';\r\n      req.user = { id: 7 };\r\n\r\n      requireSameUser('accountId')(req, res, next);\r\n\r\n      expect(next.calledOnce).to.equal(true);\r\n      expect(res.status.called).to.equal(false);\r\n    });\r\n  });\r\n});\r\n"}},"projectRoot":"C:\\Users\\barati\\OneDrive - biust.ac.bw\\Documents\\fullstack-ecommerce-app","config":{"$schema":"./node_modules/@stryker-mutator/core/schema/stryker-schema.json","testRunner":"mocha","coverageAnalysis":"perTest","mutate":["middleware/authMiddleware.js"],"mochaOptions":{"spec":["test/baseline-ai/authMid